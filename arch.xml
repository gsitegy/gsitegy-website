<mxfile host="app.diagrams.net">
  <diagram name="AWS SMB Statement AI Architecture (Enterprise)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- USER -->
        <mxCell id="user" value="SMB Tenant User" style="shape=umlActor" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="40" height="80" as="geometry"/>
        </mxCell>

        <!-- EDGE LAYER -->
        <mxCell id="cloudfront" value="CloudFront" style="rounded=1;fillColor=#dae8fc" vertex="1" parent="1">
          <mxGeometry x="120" y="260" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="waf" value="AWS WAF" style="rounded=1;fillColor=#fff2cc" vertex="1" parent="1">
          <mxGeometry x="120" y="320" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- AUTH -->
        <mxCell id="cognito" value="Cognito (Multi-tenant Auth)" style="rounded=1;fillColor=#ffe6cc" vertex="1" parent="1">
          <mxGeometry x="280" y="260" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- API -->
        <mxCell id="apigw" value="API Gateway" style="rounded=1;fillColor=#d5e8d4" vertex="1" parent="1">
          <mxGeometry x="280" y="340" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- VPC -->
        <mxCell id="vpc" value="VPC" style="rounded=1;strokeWidth=2;dashed=1" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="1100" height="600" as="geometry"/>
        </mxCell>

        <!-- PUBLIC SUBNET -->
        <mxCell id="publicsubnet" value="Public Subnet" style="rounded=1;fillColor=#f8cecc" vertex="1" parent="vpc">
          <mxGeometry x="20" y="20" width="300" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="alb" value="ALB (Optional)" style="rounded=1" vertex="1" parent="publicsubnet">
          <mxGeometry x="40" y="60" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- PRIVATE SUBNET - INGESTION -->
        <mxCell id="priv1" value="Private Subnet (Ingestion)" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="vpc">
          <mxGeometry x="350" y="20" width="350" height="250" as="geometry"/>
        </mxCell>

        <mxCell id="lambdaUpload" value="Lambda (Pre-signed URL)" style="rounded=1" vertex="1" parent="priv1">
          <mxGeometry x="40" y="60" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="s3raw" value="S3 (Tenant-isolated Raw Bucket)" style="rounded=1" vertex="1" parent="priv1">
          <mxGeometry x="40" y="140" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- SQS -->
        <mxCell id="sqs" value="SQS Queue (Decoupling)" style="rounded=1;fillColor=#fff2cc" vertex="1" parent="vpc">
          <mxGeometry x="750" y="120" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- PRIVATE SUBNET - PROCESSING -->
        <mxCell id="priv2" value="Private Subnet (Processing)" style="rounded=1;fillColor=#d5e8d4" vertex="1" parent="vpc">
          <mxGeometry x="350" y="300" width="350" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="stepfn" value="Step Functions (Orchestration)" style="rounded=1" vertex="1" parent="priv2">
          <mxGeometry x="40" y="40" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="textract" value="Textract" style="rounded=1" vertex="1" parent="priv2">
          <mxGeometry x="40" y="120" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="parser" value="Lambda (Parser)" style="rounded=1" vertex="1" parent="priv2">
          <mxGeometry x="40" y="200" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- DATA -->
        <mxCell id="ddb" value="DynamoDB (Tenant Partition Key)" style="shape=cylinder;fillColor=#dae8fc" vertex="1" parent="vpc">
          <mxGeometry x="750" y="240" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- AI LAYER -->
        <mxCell id="bedrock" value="Amazon Bedrock" style="rounded=1;fillColor=#ffe6cc" vertex="1" parent="vpc">
          <mxGeometry x="750" y="360" width="220" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="agents" value="AI Agents (Understanding | Summary | Insights)" style="rounded=1" vertex="1" parent="vpc">
          <mxGeometry x="750" y="470" width="300" height="100" as="geometry"/>
        </mxCell>

        <!-- SERVING -->
        <mxCell id="lambdaAPI" value="Lambda (Dashboard API)" style="rounded=1" vertex="1" parent="vpc">
          <mxGeometry x="350" y="650" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- CONNECTIONS -->
        <mxCell edge="1" parent="1" source="user" target="cloudfront"/>
        <mxCell edge="1" parent="1" source="cloudfront" target="waf"/>
        <mxCell edge="1" parent="1" source="waf" target="apigw"/>
        <mxCell edge="1" parent="1" source="apigw" target="lambdaUpload"/>
        <mxCell edge="1" parent="1" source="lambdaUpload" target="s3raw"/>
        <mxCell edge="1" parent="1" source="s3raw" target="sqs"/>
        <mxCell edge="1" parent="1" source="sqs" target="stepfn"/>
        <mxCell edge="1" parent="1" source="stepfn" target="textract"/>
        <mxCell edge="1" parent="1" source="stepfn" target="parser"/>
        <mxCell edge="1" parent="1" source="textract" target="ddb"/>
        <mxCell edge="1" parent="1" source="parser" target="ddb"/>
        <mxCell edge="1" parent="1" source="stepfn" target="bedrock"/>
        <mxCell edge="1" parent="1" source="bedrock" target="agents"/>
        <mxCell edge="1" parent="1" source="ddb" target="lambdaAPI"/>
        <mxCell edge="1" parent="1" source="lambdaAPI" target="apigw"/>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>